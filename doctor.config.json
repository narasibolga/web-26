{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        "files": ["src/app/**/programs/[[]slug]/page.tsx"],
        "rules": ["react-doctor/dangerous-html-sink"]
      },
      {
        "files": ["src/app/**/map/page.tsx"],
        "rules": ["react-doctor/unsafe-json-in-html"]
      },
      {
        "files": ["src/app/**/layout.tsx"],
        "rules": ["react-doctor/unsafe-json-in-html"]
      }
    ]
  }
}
